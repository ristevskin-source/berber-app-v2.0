# -*- coding: utf-8 -*-
import re

# Pročitaj app.py
with open('app.py', 'r', encoding='utf-8') as f:
    sadrzaj = f.read()

# Rečnik zamena
zamene = {
    '✅': '[OK]',
    '❌': '[X]',
    '⚠️': '[!]',
    '🔴': '[●]',
    '🟢': '[○]',
    '💰': '[$$]',
    '🔄': '[↻]',
    '📅': '[Kal]',
    '📊': '[Stat]',
    '📆': '[Mes]',
    '📋': '[List]',
    '🔑': '[Key]',
    '💈': '[Frizer]',
    '⏰': '[Sat]',
    '✂️': '[Makaze]',
    '➕': '[+]',
    '💇': '[Sisanje]',
    '🧔': '[Brada]',
    '✨': '[*]',
}

# Zameni sve
for stari, novi in zamene.items():
    sadrzaj = sadrzaj.replace(stari, novi)

# Sačuvaj
with open('app.py', 'w', encoding='utf-8') as f:
    f.write(sadrzaj)

print("✅ Svi emoji su zamenjeni!")
